# Database configuration for NeonDB
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Server Configuration
SERVER_PORT=8080

# JWT Configuration
# IMPORTANT: Generate a secure secret key (min 32 characters)
# You can use: openssl rand -base64 32
# Or you can get one from: https://generate.plus/en/base64 (choose "length in bytes" = 32)
JWT_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# CORS Configuration
CORS_ALLOWED_ORIGIN_1=

# Encryption Key for sensitive data (AES-256)
# IMPORTANT: Changing this will make old encrypted passwords unreadable.
# You can use: openssl rand -base64 32
# Or you can get one from: https://generate.plus/en/base64 (choose "length in bytes" = 32)
ENCRYPTION_AES_KEY=

# Gemini API key and model selection
# Get these from: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=
GEMINI_CHAT_MODEL=

# Gmail Push Notifications
GMAIL_PUBSUB_TOPIC=projects/{PROJECT_ID}/topics/gmail-notifications

# Ngrok Auth Token (for Dockerized tunnel)
NGROK_AUTHTOKEN=
